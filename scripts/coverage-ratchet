#!/usr/bin/env python3
"""Hold a pull request's coverage to fixed floors, overall and on the lines it adds.

Reads the summaries `scripts/coverage` writes - one from the pinned stable toolchain, one from the
condition-coverage nightly - for main and for the pull request, the pull request's line coverage
as lcov, and its diff against main, and writes a Markdown section for the pull request's job
summary.  architecture/testing.md has the reasoning.

    scripts/coverage-ratchet --head-stable F --head-lcov F --diff F [--head-stable-repeat F]
                             [--base-stable F] [--base-condition F] [--head-condition F]
                             [--summary F]

Two gates, each a fixed figure set below, so every pull request is held to the same bar whatever
state main is in:

- **Overall**: each metric in FLOORS fails the run when the pull request's share covered is below
  its floor.  The others are reported and never fail it.
- **New code**: the coverable lines the pull request adds fail the run when their share covered is
  below NEW_CODE_FLOOR *and* more than NEW_CODE_ALLOWANCE of them are uncovered, so a change of a
  line or two is not held to a percentage it cannot meet.  A pull request that adds no coverable
  line passes, and the summary says so.

Main's figures are compared and reported, never gated: they show what a pull request changed, but
a bar that moved with main would differ from one pull request to the next.

A gate that cannot be evaluated - a summary, the lcov or the diff missing or unreadable, or a diff
naming a path it cannot read - fails the run, because a gate that cannot judge has not passed.

A second stable measurement of the pull request, given with --head-stable-repeat, must match the
first file for file and metric for metric.  If it does not, coverage depends on something other
than the code - test order, timing, a random input - and the figures mean nothing, so the run
fails naming the files that differed.  Without it, the summary says determinism was not checked.

Exit status: 0 when every gate holds, 1 when one does not, 2 when one could not be evaluated or
the measurement was not deterministic.  The summary is written in every case, so the job page says
which.
"""

import argparse
import json
import re
import sys
from fractions import Fraction

# Each metric: the summary it is read from, and the field of an llvm-cov summary that holds it.
# Condition coverage is the `branches` field of the nightly's summary: built with
# `-Zcoverage-options=condition`, llvm-cov counts each condition of a boolean expression as a
# branch.
METRICS = {
    "lines": ("stable", "lines"),
    "regions": ("stable", "regions"),
    "conditions": ("condition", "branches"),
}

# The overall floor of each gated metric: the share of the workspace that must be covered.  Set a
# little below where coverage stands, so one pull request's unreachable error branches do not
# fail it but a slide does; raise one deliberately, in its own change.  Condition coverage joins
# these when its compiler flag reaches stable, and the nightly is then dropped.
FLOORS = {
    "lines": Fraction(98, 100),
    "regions": Fraction(975, 1000),
}

# The share of the coverable lines a pull request adds that must be covered, and how many of them
# may be uncovered whatever that share: below the floor fails only with more uncovered than this.
NEW_CODE_FLOOR = Fraction(90, 100)
NEW_CODE_ALLOWANCE = 2

# How many files to name in a list.
MAX_FILES = 15


class NoFigure(Exception):
    """A summary, lcov or diff that cannot be read or counts nothing, with the reason."""


def load(path):
    """Read one `scripts/coverage` summary.

    Returns:
        dict: `{"totals": {field: (covered, count)}, "files": {path: {field: (covered, count)}}}`.

    Raises:
        NoFigure: The file is absent, not JSON, not an llvm-cov summary, or counts no files.
    """
    if path is None:
        raise NoFigure("not measured")
    try:
        with open(path, encoding="utf-8") as f:
            document = json.load(f)
    except FileNotFoundError:
        raise NoFigure(f"no summary at {path!r}") from None
    except (OSError, ValueError) as exc:
        raise NoFigure(f"{path!r} could not be read as JSON: {exc}") from exc
    try:
        export = document["data"][0]
        files = export["files"]
        totals = export["totals"]
    except (KeyError, IndexError, TypeError):
        raise NoFigure(f"{path!r} is not an llvm-cov summary (no data[0].files and totals)") from None
    if not files:
        raise NoFigure(f"{path!r} covers no files, so the tests produced no coverage data")

    def pairs(summary):
        out = {}
        for field, value in summary.items():
            if isinstance(value, dict) and "count" in value and "covered" in value:
                out[field] = (int(value["covered"]), int(value["count"]))
        return out

    return {
        "totals": pairs(totals),
        "files": {f["filename"]: pairs(f["summary"]) for f in files},
    }


def figure(summary, field):
    """A metric's (covered, count) from a loaded summary.

    Raises:
        NoFigure: The summary has no such field, or it counts nothing.
    """
    covered, count = summary["totals"].get(field, (0, 0))
    if count == 0:
        raise NoFigure(f"nothing counted for {field}")
    return covered, count


def percent(covered, count):
    return f"{100 * covered / count:.2f}%"


def files_that_fell(base, head, field):
    """Files with more uncovered items in `field` on the pull request than on main, worst first."""
    rows = []
    for name, pairs in head["files"].items():
        covered, count = pairs.get(field, (0, 0))
        base_covered, base_count = base["files"].get(name, {}).get(field, (0, 0))
        grew = (count - covered) - (base_count - base_covered)
        if grew > 0:
            rows.append((grew, name, covered, count))
    rows.sort(key=lambda row: (-row[0], row[1]))
    return rows


def load_lcov(path):
    """Read the pull request's line coverage, as `scripts/coverage` writes it in lcov.

    Returns:
        dict: `{path: {line: hits}}` for every instrumented line, paths relative to the tree.

    Raises:
        NoFigure: The file is absent or unreadable, or records no file.
    """
    if path is None:
        raise NoFigure("no lcov was given")
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        raise NoFigure(f"no lcov at {path!r}") from None
    except (OSError, ValueError) as exc:
        raise NoFigure(f"{path!r} could not be read: {exc}") from exc
    files, current = {}, None
    for number, line in enumerate(text.splitlines(), 1):
        if line.startswith("SF:"):
            current = files.setdefault(line[3:], {})
        elif line.startswith("DA:"):
            if current is None:
                raise NoFigure(f"{path!r} line {number} records a line before naming its file")
            try:
                at, hits = line[3:].split(",")[:2]
                at, hits = int(at), int(hits)
            except ValueError:
                raise NoFigure(f"{path!r} line {number} is not a DA record: {line!r}") from None
            current[at] = current.get(at, 0) + hits
        elif line == "end_of_record":
            current = None
    if not files:
        raise NoFigure(f"{path!r} records no file, so the tests produced no coverage data")
    return files


HUNK = re.compile(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@")


def load_diff(path):
    """Read the lines a pull request adds, from `git diff` of main against the merge.

    Returns:
        dict: `{path: set of line numbers}` in the pull request's version of each file.

    Raises:
        NoFigure: The file is absent or unreadable, or names a path this cannot read.
    """
    if path is None:
        raise NoFigure("no diff was given")
    try:
        # A diff carries the changed files' own bytes, in whatever encoding they are; only each
        # line's first character matters here, so undecodable bytes are kept, not refused.
        with open(path, encoding="utf-8", errors="surrogateescape") as f:
            text = f.read()
    except FileNotFoundError:
        raise NoFigure(f"no diff at {path!r}") from None
    except (OSError, ValueError) as exc:
        raise NoFigure(f"{path!r} could not be read: {exc}") from exc
    added, current, at = {}, None, None
    for number, line in enumerate(text.splitlines(), 1):
        if line.startswith("+++ "):
            name = line[4:]
            if name == "/dev/null":
                current = None
            elif name.startswith("b/"):
                current = added.setdefault(name[2:], set())
            else:
                # git quotes a path with unusual characters; reading it wrongly would judge the
                # wrong lines, so it is refused rather than skipped.
                raise NoFigure(f"{path!r} line {number} names a path this cannot read: {name!r}")
            at = None
        elif line.startswith("@@"):
            match = HUNK.match(line)
            if not match:
                raise NoFigure(f"{path!r} line {number} is not a hunk header: {line!r}")
            at = int(match.group(1))
        elif at is not None and current is not None and line.startswith("+"):
            current.add(at)
            at += 1
        elif at is not None and line.startswith(" "):
            at += 1
    return added


def spans(lines):
    """Line numbers as ranges, `3-5, 9`."""
    out, ordered = [], sorted(lines)
    start = previous = None
    for line in ordered:
        if previous is not None and line == previous + 1:
            previous = line
            continue
        if start is not None:
            out.append(f"{start}-{previous}" if previous != start else f"{start}")
        start = previous = line
    if start is not None:
        out.append(f"{start}-{previous}" if previous != start else f"{start}")
    return ", ".join(out)


def new_code(coverage, added):
    """The coverable lines the pull request adds, and which of them no test ran.

    Returns:
        tuple: (covered, count, uncovered) where `uncovered` is `[(path, lines)]` by path.
    """
    covered = count = 0
    uncovered = []
    for name in sorted(added):
        lines = coverage.get(name, {})
        coverable = [line for line in added[name] if line in lines]
        missed = [line for line in coverable if lines[line] == 0]
        count += len(coverable)
        covered += len(coverable) - len(missed)
        if missed:
            uncovered.append((name, missed))
    return covered, count, uncovered


def compare(sides):
    """Compare every metric with its floor, and with main.

    Returns:
        tuple: (rows, below, unevaluated, details) for the summary, where `below` holds the gated
        metrics under their floor.
    """
    rows, below, unevaluated, details = [], [], [], []
    for metric, (source, field) in METRICS.items():
        floor = FLOORS.get(metric)
        role = f"floor {float(floor) * 100:g}%" if floor is not None else "report only"
        base, head = sides[("base", source)], sides[("head", source)]
        try:
            if isinstance(head, NoFigure):
                raise head
            head_covered, head_count = figure(head, field)
        except NoFigure as exc:
            rows.append((metric, role, "-", f"no data: {exc}", "-"))
            if floor is not None:
                unevaluated.append(f"{metric}: the pull request has no figure ({exc})")
            continue
        head_share = Fraction(head_covered, head_count)
        head_text = f"{percent(head_covered, head_count)} ({head_covered}/{head_count})"
        if floor is not None and head_share < floor:
            below.append(metric)
        try:
            if isinstance(base, NoFigure):
                raise base
            base_covered, base_count = figure(base, field)
        except NoFigure as exc:
            rows.append((metric, role, f"no figure: {exc}", head_text, "-"))
            continue
        change = float(head_share - Fraction(base_covered, base_count)) * 100
        rows.append((metric, role, f"{percent(base_covered, base_count)} ({base_covered}/{base_count})",
                     head_text, f"{change:+.2f}"))
        worst = files_that_fell(base, head, field)
        if worst:
            details.append((metric, worst))
    return rows, below, unevaluated, details


def undeterministic(first, repeat):
    """Files whose figures differ between two measurements of the same code, with both figures.

    Returns:
        list: `(file, first, repeat)` per file that differs, where each figure is that file's
        `{field: (covered, count)}`, or None when the file is absent from that measurement.
    """
    differ = []
    for name in sorted(set(first["files"]) | set(repeat["files"])):
        a, b = first["files"].get(name), repeat["files"].get(name)
        if a != b:
            differ.append((name, a, b))
    return differ


def describe(figures, fields):
    if figures is None:
        return "absent"
    return ", ".join(f"{field} {covered}/{count}" for field, (covered, count) in sorted(figures.items())
                     if field in fields)


def render(rows, below, new, unevaluated, details, determinism):
    """The Markdown section: the verdict, then the figures behind it."""
    out = ["## Coverage", ""]
    failing = list(below) + (["new code"] if new.get("fails") else [])
    if unevaluated:
        out.append("**Not evaluated, so the check fails:**")
        out += [f"- {line}" for line in unevaluated]
    elif failing:
        out.append(f"**Below its floor: {', '.join(failing)}.**")
    else:
        out.append("Every gated metric is at or above its floor, overall and on the new code.")

    out += ["", "**New code:** " + new["text"]]
    for name, lines in new.get("uncovered", [])[:MAX_FILES]:
        out.append(f"- `{name}`: line{'s' if len(lines) > 1 else ''} {spans(lines)}")
    if len(new.get("uncovered", [])) > MAX_FILES:
        out.append(f"- and {len(new['uncovered']) - MAX_FILES} more files")

    status, differ = determinism
    out += ["", f"**Determinism:** {status}"]
    for name, a, b in differ[:MAX_FILES]:
        # The fields that differ, whichever they are: a file can differ in functions or
        # instantiations with its lines and regions the same.
        fields = {f for f in set(a or {}) | set(b or {}) if (a or {}).get(f) != (b or {}).get(f)} or set(a or b)
        out.append(f"- `{name}`: {describe(a, fields)} in one measurement, {describe(b, fields)} in the other")
    if len(differ) > MAX_FILES:
        out.append(f"- and {len(differ) - MAX_FILES} more")
    out += ["", "| Metric | main | this pull request | change (points) | |",
            "| --- | --- | --- | --- | --- |"]
    for metric, role, base, head, change in rows:
        out.append(f"| {metric} | {base} | {head} | {change} | {role} |")
    for metric, worst in details:
        out += ["", f"**{metric}**, files with more uncovered than on main (reported, not gated):", ""]
        for grew, name, covered, count in worst[:MAX_FILES]:
            out.append(f"- `{name}`: {grew} more uncovered, now {covered}/{count}")
        if len(worst) > MAX_FILES:
            out.append(f"- and {len(worst) - MAX_FILES} more")
    return "\n".join(out) + "\n"


def judge_new_code(lcov_path, diff_path, unevaluated):
    """The new-code gate's verdict and the summary's words for it."""
    try:
        added = load_diff(diff_path)
        coverage = load_lcov(lcov_path)
    except NoFigure as exc:
        unevaluated.append(f"new code: {exc}")
        return {"text": f"not evaluated ({exc})."}
    covered, count, uncovered = new_code(coverage, added)
    if count == 0:
        return {"text": "this pull request adds no coverable line, so there is nothing to judge."}
    missed = count - covered
    share = Fraction(covered, count)
    fails = share < NEW_CODE_FLOOR and missed > NEW_CODE_ALLOWANCE
    floor = f"{float(NEW_CODE_FLOOR) * 100:g}%"
    text = (f"{percent(covered, count)} ({covered}/{count}) of the coverable lines this pull request adds "
            f"are covered; the floor is {floor}, with up to {NEW_CODE_ALLOWANCE} uncovered lines allowed "
            "whatever the share.")
    if fails:
        text += f"  **{missed} are uncovered, so it fails.**"
    if uncovered:
        text += "  Uncovered:"
    return {"text": text, "fails": fails, "uncovered": uncovered}


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    for side in ("base", "head"):
        for source in ("stable", "condition"):
            parser.add_argument(f"--{side}-{source}", metavar="FILE")
    parser.add_argument("--head-stable-repeat", metavar="FILE",
                        help="a second stable measurement of the pull request, to check it matches the first")
    parser.add_argument("--head-lcov", metavar="FILE",
                        help="the pull request's line coverage in lcov, from its stable measurement")
    parser.add_argument("--diff", metavar="FILE",
                        help="git diff of main against the pull request, with no context lines")
    parser.add_argument("--summary", metavar="FILE",
                        help="append the Markdown section here (the job summary); default stdout only")
    args = parser.parse_args(argv)

    sides = {}
    for side in ("base", "head"):
        for source in ("stable", "condition"):
            try:
                sides[(side, source)] = load(getattr(args, f"{side}_{source}"))
            except NoFigure as exc:
                sides[(side, source)] = exc

    rows, below, unevaluated, details = compare(sides)
    new = judge_new_code(args.head_lcov, args.diff, unevaluated)

    differ = []
    if args.head_stable_repeat is None:
        determinism = "not checked: no second measurement of the pull request was given."
    else:
        first = sides[("head", "stable")]
        try:
            repeat = load(args.head_stable_repeat)
        except NoFigure as exc:
            determinism = f"not established: the second measurement has no figure ({exc})."
            unevaluated.append(f"determinism: the second measurement of the pull request has no figure ({exc})")
        else:
            if isinstance(first, NoFigure):
                determinism = "not established: the first measurement has no figure."
            else:
                differ = undeterministic(first, repeat)
                if differ:
                    determinism = (f"**two measurements of the same code differ in {len(differ)} file(s)**, so "
                                   "coverage depends on more than the code and the figures mean nothing:")
                    unevaluated.append(f"determinism: two measurements of the same code differ in {len(differ)} file(s)")
                else:
                    determinism = "two measurements of the pull request matched in every file."
    text = render(rows, below, new, unevaluated, details, (determinism, differ))
    sys.stdout.write(text)
    if args.summary:
        with open(args.summary, "a", encoding="utf-8") as f:
            f.write(text)
    if unevaluated:
        for line in unevaluated:
            print(f"coverage-ratchet: not evaluated - {line}", file=sys.stderr)
        return 2
    failing = list(below) + (["new code"] if new.get("fails") else [])
    if failing:
        print(f"coverage-ratchet: below its floor: {', '.join(failing)}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
