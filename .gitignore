# Hidden files are ignored unless listed here, so a tool's local state never lands in a
# commit by accident.
/.*
!/.agents/
!/.gitignore
!/.gitattributes
!/.github/
!/.cursor/
!/.vscode/
!/.claude/
/.claude/settings.local.json

# Rust.  Cargo.lock is committed deliberately: this is a binary, and CI builds --locked.
/target/
**/*.rs.bk

# What cargo flamegraph records into the directory it runs in; architecture/verification.md.
perf.data
perf.data.old
cargo-flamegraph.trace

# JetBrains
/.idea/

# OS
.DS_Store
ehthumbs.db
Icon?
Thumbs.db
*~
*.bak
